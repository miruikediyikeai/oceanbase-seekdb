COUNT(*)	SUM(id)
725	281222
SELECT COUNT(*),SUM(id) FROM docs WHERE MATCH(body) AGAINST('alpha beta gamma') BETWEEN 0.01 AND 0.2;
COUNT(*)	SUM(id)
0	NULL
SELECT COUNT(*),SUM(id) FROM docs WHERE NOT MATCH(body) AGAINST('alpha');
COUNT(*)	SUM(id)
414	160658
SELECT COUNT(*),SUM(id) FROM docs WHERE MATCH(body) AGAINST('alpha') OR id%17=0;
COUNT(*)	SUM(id)
387	149811
SELECT COUNT(*),SUM(id) FROM docs WHERE MATCH(body) AGAINST('+alpha -gamma' IN BOOLEAN MODE);
COUNT(*)	SUM(id)
242	94108
