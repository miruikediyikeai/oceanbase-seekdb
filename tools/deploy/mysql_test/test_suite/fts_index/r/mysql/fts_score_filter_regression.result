COUNT(*)	SUM(id)
0	NULL
SELECT COUNT(*),SUM(id) FROM docs WHERE MATCH(body) AGAINST('');
COUNT(*)	SUM(id)
0	NULL
SELECT id,MATCH(body) AGAINST('alpha beta gamma')<>0 AS truth FROM docs WHERE id<12 ORDER BY id;
