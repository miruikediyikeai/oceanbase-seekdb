SELECT COUNT(*) FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST('common') LIMIT 0)t;
COUNT(*)
0
SELECT COUNT(*),SUM(id) FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST('common') ORDER BY id LIMIT 13 OFFSET 257)t;
COUNT(*)	SUM(id)
13	3662
PREPARE stmt FROM 'SELECT COUNT(*),SUM(id) FROM docs WHERE MATCH(body) AGAINST(?)';
SET @words='alpha beta';
EXECUTE stmt USING @words;
COUNT(*)	SUM(id)
725	281222
SET @words='gamma';
EXECUTE stmt USING @words;
COUNT(*)	SUM(id)
242	93753
SET @words='nonexistentzz';
EXECUTE stmt USING @words;
COUNT(*)	SUM(id)
0	NULL
DEALLOCATE PREPARE stmt;
