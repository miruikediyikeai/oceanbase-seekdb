DROP INDEX beng_body ON docs;
CREATE FULLTEXT INDEX beng_body ON docs(body) WITH PARSER beng;
SELECT COUNT(*),SUM(id),SUM(CRC32(id)) FROM docs WHERE MATCH(body) AGAINST('alpha beta gamma');
COUNT(*)	SUM(id)	SUM(CRC32(id))
916	472464	1878863381834
CREATE TABLE partitioned_docs(id INT PRIMARY KEY,body TEXT) PARTITION BY HASH(id) PARTITIONS 4;
INSERT INTO partitioned_docs SELECT id,body FROM docs;
CREATE FULLTEXT INDEX part_ft ON partitioned_docs(body) WITH PARSER beng;
SELECT COUNT(*),SUM(id),SUM(CRC32(id)) FROM partitioned_docs WHERE MATCH(body) AGAINST('alpha beta gamma');
COUNT(*)	SUM(id)	SUM(CRC32(id))
916	472464	1878863381834
