CREATE TABLE docs(id VARCHAR(32) PRIMARY KEY, title VARCHAR(128), body TEXT);
INSERT INTO docs VALUES
('a','中国人民银行','全文搜索 数据库 alpha alpha'),
('b','南京市长江大桥','全文搜索 beta 数据库'),
('c','English','alpha database performance'),
('d','EMPTY',''),('e',NULL,NULL),
('f','alpha beta','database database audit'),
('g','研究生命起源','中国 数据库 全文搜索');
ALTER TABLE docs ADD FULLTEXT INDEX ik_idx(title,body) WITH PARSER ik;
ALTER TABLE docs ADD FULLTEXT INDEX beng_idx(body) WITH PARSER beng;
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('全文搜索 数据库') ORDER BY id;
id
a
b
g
SELECT id, ROUND(MATCH(title,body) AGAINST('全文搜索 数据库'),8) AS score FROM docs WHERE MATCH(title,body) AGAINST('全文搜索 数据库') ORDER BY score DESC,id;
id	score
a	0.90145393
b	0.90145393
g	0.85941722
SELECT id FROM docs WHERE MATCH(body) AGAINST('database alpha') ORDER BY id;
id
a
c
f
SELECT id FROM docs WHERE MATCH(body) AGAINST('+database -audit' IN BOOLEAN MODE) ORDER BY id;
id
c
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('alpha 数据库') ORDER BY id LIMIT 2 OFFSET 1;
id
b
c
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('nonexistentzz') ORDER BY id;
id
INSERT INTO docs VALUES ('h','全文搜索','alpha database 数据库');
UPDATE docs SET body='audit beta 数据库' WHERE id='a';
DELETE FROM docs WHERE id='c';
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('全文搜索 数据库') ORDER BY id;
id
a
b
g
h
SELECT id FROM docs WHERE MATCH(body) AGAINST('database alpha') ORDER BY id;
id
f
h
START TRANSACTION;
UPDATE docs SET body='alpha alpha' WHERE id='b';
ROLLBACK;
SELECT id FROM docs WHERE MATCH(body) AGAINST('alpha') ORDER BY id;
id
h
DROP DATABASE fts_hotpath_regression;
