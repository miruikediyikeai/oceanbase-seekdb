START TRANSACTION;
UPDATE docs SET body='alpha beta gamma' WHERE id%19=0;
DELETE FROM docs WHERE id%23=0;
SELECT COUNT(*), SUM(CRC32(CONCAT(id,':',ROUND(MATCH(body) AGAINST('alpha beta gamma'),10)))) FROM docs WHERE MATCH(body) AGAINST('alpha beta gamma');
COUNT(*)	SUM(CRC32(CONCAT(id,':',ROUND(MATCH(body) AGAINST('alpha beta gamma'),10))))
858	1835627347816
ROLLBACK;
SELECT COUNT(*), SUM(CRC32(CONCAT(id,':',ROUND(MATCH(body) AGAINST('alpha beta gamma'),10)))) FROM docs WHERE MATCH(body) AGAINST('alpha beta gamma');
COUNT(*)	SUM(CRC32(CONCAT(id,':',ROUND(MATCH(body) AGAINST('alpha beta gamma'),10))))
