4	{"tokens": [{"银行": 1}, {"中国": 1}, {"人民银行": 1}, {"中国人民银行": 1}, {"alpha": 1}, {"中国人": 1}, {"中国人民": 1}, {"国人": 1}, {"人民": 1}, {"beta": 1}], "doc_len": 10}
3	{"tokens": [{"lph": 1}, {"人民银": 1}, {"bet": 1}, {"国人民": 1}, {"alp": 1}, {"中国人": 1}, {"eta": 1}, {"pha": 1}, {"民银行": 1}], "doc_len": 9}
