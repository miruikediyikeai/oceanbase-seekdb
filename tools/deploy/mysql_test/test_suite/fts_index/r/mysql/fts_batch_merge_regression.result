CREATE TABLE texts(id INT PRIMARY KEY, text_value VARCHAR(4096));
INSERT INTO texts VALUES (1,'alpha beta alpha'),(2,'café cafe café'),(3,''),(4,NULL),
(5,'中国人民银行 全文搜索'),(6,'alpha'),(7,REPEAT('alpha ',200)),(8,'中国 中国 搜索');
SELECT id, TOKENIZE(text_value,'beng','[{"output":"all"}]') AS tokens FROM texts ORDER BY id;
id	tokens
1	{"tokens": [{"alpha": 2}, {"beta": 1}], "doc_len": 3}
2	{"tokens": [{"café": 3}], "doc_len": 3}
3	{"tokens": [], "doc_len": 0}
4	{"tokens": [], "doc_len": 0}
5	{"tokens": [{"中国人民银行": 1}, {"全文搜索": 1}], "doc_len": 2}
6	{"tokens": [{"alpha": 1}], "doc_len": 1}
7	{"tokens": [{"alpha": 200}], "doc_len": 200}
8	{"tokens": [{"中国": 2}, {"搜索": 1}], "doc_len": 3}
SELECT id, TOKENIZE(text_value,'ik','[{"output":"all"}]') AS tokens FROM texts ORDER BY id;
id	tokens
1	{"tokens": [{"alpha": 2}, {"beta": 1}], "doc_len": 3}
2	{"tokens": [{"cafe": 1}, {"caf": 2}], "doc_len": 3}
3	{"tokens": [], "doc_len": 0}
4	{"tokens": [], "doc_len": 0}
5	{"tokens": [{"中国人民银行": 1}, {"搜索": 1}, {"全文": 1}], "doc_len": 3}
6	{"tokens": [{"alpha": 1}], "doc_len": 1}
7	{"tokens": [{"alpha": 200}], "doc_len": 200}
8	{"tokens": [{"中国": 2}, {"搜索": 1}], "doc_len": 3}
SELECT TOKENIZE('café cafe café','space','[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"café": 3}], "doc_len": 3}
SELECT TOKENIZE('alpha','beng','[{"output":"invalid"}]');
ERROR HY000: Incorrect arguments to output mode should be string default or all
SELECT TOKENIZE('beta beta alpha','beng','[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"alpha": 1}, {"beta": 2}], "doc_len": 3}
SELECT TOKENIZE(TOKENIZE('alpha beta','beng'),'beng') AS nested_tokens;
nested_tokens
[]
CREATE TABLE configs(id INT PRIMARY KEY, parser_name VARCHAR(32), config VARCHAR(1024));
INSERT INTO configs VALUES
(1,'beng','[{"output":"all"},{"additional_args":[{"min_token_size":5}]}]'),
(2,'space','[{"output":"all"},{"additional_args":[{"min_token_size":2}]}]'),
(3,'ngram','[{"output":"all"},{"additional_args":[{"ngram_token_size":3}]}]'),
(4,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]'),
(5,'beng','[{"output":"all"},{"additional_args":[{"min_token_size":5}]}]'),
(6,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT id,TOKENIZE('alpha beta 中国人民银行',parser_name,config) AS tokens FROM configs ORDER BY id;
id	tokens
1	{"tokens": [{"中国人民银行": 1}, {"alpha": 1}], "doc_len": 2}
2	{"tokens": [{"中国人民银行": 1}, {"alpha": 1}, {"beta": 1}], "doc_len": 3}
3	{"tokens": [{"lph": 1}, {"人民银": 1}, {"bet": 1}, {"国人民": 1}, {"alp": 1}, {"中国人": 1}, {"eta": 1}, {"pha": 1}, {"民银行": 1}], "doc_len": 9}
4	{"tokens": [{"银行": 1}, {"中国": 1}, {"人民银行": 1}, {"中国人民银行": 1}, {"alpha": 1}, {"中国人": 1}, {"中国人民": 1}, {"国人": 1}, {"人民": 1}, {"beta": 1}], "doc_len": 10}
5	{"tokens": [{"中国人民银行": 1}, {"alpha": 1}], "doc_len": 2}
6	{"tokens": [{"中国人民银行": 1}, {"alpha": 1}, {"beta": 1}], "doc_len": 3}
SELECT id,TOKENIZE('alpha beta 中国人民银行',parser_name,config) AS tokens FROM configs ORDER BY id DESC;
id	tokens
